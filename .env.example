# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Yalnızca sunucu tarafında öğretmen hesabı oluşturmak için kullanılır.
# Bu değere NEXT_PUBLIC_ öneki eklemeyin ve Git'e göndermeyin.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Uygulamada gösterilecek kurum adı
NEXT_PUBLIC_INSTITUTION_NAME=Şermin Şahin Kişisel Gelişim Kursu

# Telefon bildirimleri (Web Push). Anahtar çifti: npx web-push generate-vapid-keys
# VAPID_SUBJECT uygulamanın adresi olmalı. NOTIFICATION_DISPATCH_SECRET, Supabase
# Vault'taki notification_dispatch_secret ile aynı olmalı.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
VAPID_SUBJECT=https://egitim-kurum-yonetim.vercel.app
NOTIFICATION_DISPATCH_SECRET=YOUR_DISPATCH_SECRET
